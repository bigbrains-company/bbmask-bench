# Data Mask API key from the console at https://app.bbmask.co
# Copy this file to .env and fill in the key. Never commit .env.
BB_ANONYM_TOKEN=dm_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Only for `bbmask-bench audit`: a key for the language model that double-checks the masked
# text. Any OpenAI-compatible endpoint works; set OPENAI_BASE_URL for another provider.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides
# BBMASK_BASE_URL=https://app.bbmask.co
# BBMASK_TIMEOUT=150
# BBMASK_BENCH_CORPUS=./olusturma
